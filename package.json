{
  "name": "playwright-web-automation",
  "version": "1.0.0",
  "description": "Custom Playwright + Node.js UI test automation framework with tag-based execution, Extent/Allure reporting, and Jenkins support.",
  "main": "runner.js",
  "scripts": {
    "test": "node runner.js",
    "test:smoke": "node runner.js --tags smoke",
    "test:regression": "node runner.js --tags regression",
    "install:browsers": "playwright install",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chai": "^4.5.0",
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "allure-commandline": "^2.42.0",
    "allure-js-commons": "^3.9.0"
  }
}
